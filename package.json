{
  "name": "pomo-workbench",
  "version": "1.1.8",
  "description": "个人工作台 · 今日三列任务看板",
  "main": "electron/main.js",
  "author": "方城县破默网络科技工作室 <1316737309@qq.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pomo.workbench",
    "productName": "Workbench",
    "copyright": "Copyright © 2026 李德胜 · 方城县破默网络科技工作室",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "assets/logo.png",
    "afterPack": "build/after-pack.js",
    "files": [
      "electron/**/*",
      "assets/**/*",
      "index.html",
      "widget.html",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "个人工作台",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": false,
      "runAfterFinish": true,
      "unicode": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "en",
        "en-US",
        "zh_CN",
        "zh-CN"
      ]
    }
  },
  "allowScripts": {
    "electron": true
  }
}

